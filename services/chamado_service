from repositories.chamado_repository import ChamadoRepository
from repositories.usuario_repository import UsuarioRepository

class ChamadoService():
    @staticmethod
    def _formata(chamado):
        return {
            "id": chamado.id,
            "titulo": chamado.titulo,
            "descricao": chamado.descricao,
            "prioridade": chamado.prioridade,
            "status": chamado.status,
            "tecnico": chamado.tecnico,
            "data_abertura": chamado.data_abertura.strftime("%d/%m/%Y %H:%M"),
            "usuario_id": chamado.usuario_id
        }

    @staticmethod
    def consulta_chamados():
        chamados = ChamadoRepository.consulta_tudo()
        return [ChamadoService._formata(chamado) for chamado in chamados]

    @staticmethod
    def consulta_por_usuario(usuario_id):
        chamados = ChamadoRepository.consulta_por_usuario(usuario_id)
        return [ChamadoService._formata(chamado) for chamado in chamados]

    @staticmethod
    def consulta_abertos():
        chamados = ChamadoRepository.consulta_abertos()
        return [ChamadoService._formata(chamado) for chamado in chamados]

    @staticmethod
    def consulta_prioridade_alta():
        chamados = ChamadoRepository.consulta_prioridade_alta()
        return [ChamadoService._formata(chamado) for chamado in chamados]

    @staticmethod
    def busca_chamado(id):
        return ChamadoRepository.consulta_um(id)

    @staticmethod
    def usuario_existe(usuario_id):
        return UsuarioRepository.consulta_um(usuario_id) is not None

    @staticmethod
    def limite_alta_excedido(usuario_id):
        total = ChamadoRepository.conta_alta_nao_encerrados_por_usuario(usuario_id)
        return total >= 5

    @staticmethod
    def cadastra_chamado(**kwargs):
        chamado = ChamadoRepository.cadastrar_chamado(kwargs)
        return chamado

    @staticmethod
    def atualiza_chamado(id, **kwargs):
        chamado = ChamadoRepository.atualizar_chamado(id, kwargs)
        return chamado

    @staticmethod
    def exclui_chamado(id):
        return ChamadoRepository.excluir_chamado(id)

    @staticmethod
    def iniciar_chamado(id):
        chamado = ChamadoRepository.consulta_um(id)
        if not chamado:
            return None, "nao_encontrado"
        if chamado.status != "Aberto":
            return None, "transicao_invalida"
        atualizado = ChamadoRepository.alterar_status(id, "Em atendimento")
        return atualizado, None

    @staticmethod
    def encerrar_chamado(id):
        chamado = ChamadoRepository.consulta_um(id)
        if not chamado:
            return None, "nao_encontrado"
        if chamado.status != "Em atendimento":
            return None, "transicao_invalida"
        atualizado = ChamadoRepository.alterar_status(id, "Encerrado")
        return atualizado, None

    @staticmethod
    def gera_estatisticas():
        usuarios = UsuarioRepository.conta_total_usuarios()
        total = ChamadoRepository.conta_total_chamados()
        abertos = ChamadoRepository.conta_por_status("Aberto")
        em_atendimento = ChamadoRepository.conta_por_status("Em atendimento")
        encerrados = ChamadoRepository.conta_por_status("Encerrado")

        return {
            "usuarios": usuarios,
            "chamados": total,
            "abertos": abertos,
            "em_atendimento": em_atendimento,
            "encerrados": encerrados
        }
