from flask import jsonify, request
from services.usuario_service import UsuarioService

class UsuarioController():

    @staticmethod
    def valida_dados(dados, id_atual=None):
        if not dados:
            return jsonify({"erro": "JSON inválido"}), 400

        nome = dados.get("nome")
        if not nome:
            return jsonify({"erro": "Nome é obrigatório"}), 400

        email = dados.get("email")
        if not email:
            return jsonify({"erro": "Email é obrigatório"}), 400

        setor = dados.get("setor")
        if not setor:
            return jsonify({"erro": "Setor é obrigatório"}), 400

        usuario_existente = UsuarioService.consulta_email(email)
        if usuario_existente and usuario_existente.id != id_atual:
            return jsonify({"erro": "Já existe um usuário com este e-mail"}), 400

        return True

    @staticmethod
    def listar():
        resultado = UsuarioService.consulta_usuarios()
        return jsonify(resultado)

    @staticmethod
    def cadastrar():
        dados = request.json
        valida_dados = UsuarioController.valida_dados(dados)
        if valida_dados is not True:
            return valida_dados

        usuario = UsuarioService.cadastra_usuario(
            nome=dados["nome"],
            email=dados["email"],
            setor=dados["setor"]
        )

        return jsonify({
            "mensagem": "Usuário cadastrado",
            "id": usuario.id
        }), 201

    @staticmethod
    def atualizar(id):
        dados = request.json
        valida_dados = UsuarioController.valida_dados(dados, id_atual=id)
        if valida_dados is not True:
            return valida_dados

        usuario = UsuarioService.atualiza_usuario(
            id=id,
            nome=dados["nome"],
            email=dados["email"],
            setor=dados["setor"]
        )

        if not usuario:
            return jsonify({"erro": "Usuário não encontrado"}), 404

        return jsonify({
            "mensagem": "Usuário atualizado",
            "id": usuario.id
        })

    @staticmethod
    def excluir(id):
        resultado = UsuarioService.exclui_usuario(id)

        if resultado is None:
            return jsonify({"erro": "Usuário não encontrado"}), 404

        if resultado == "possui_chamados":
            return jsonify({"erro": "Não é possível excluir usuário que possui chamados cadastrados"}), 400

        return jsonify({
            "mensagem": "Usuário excluído",
            "id": resultado.id
        })

    @staticmethod
    def listar_chamados(id):
        usuario = UsuarioService.consulta_usuario(id)
        if not usuario:
            return jsonify({"erro": "Usuário não encontrado"}), 404

        from services.chamado_service import ChamadoService
        resultado = ChamadoService.consulta_por_usuario(id)
        return jsonify(resultado)
